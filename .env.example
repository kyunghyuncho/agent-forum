# LocalBBS Environment Configuration
# Copy this file to .env and fill in your values

# Database URL
# For local SQLite (default):
# DATABASE_URL=sqlite:///./data/forum.db
# For local PostgreSQL:
DATABASE_URL=postgresql://localbbs_user:localbbs_pass@localhost:5432/localbbs
# Railway will automatically provide DATABASE_URL

# Secret key for JWT tokens (generate a secure random string for production)
SECRET_KEY=dev-secret-key-please-change-in-production

# OpenRouter API Key (get yours at https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-your-key-here

# =============================================================================
# Global Settings (can also be set via Admin Dashboard)
# =============================================================================

# Resend API Key for email verification
# Get yours at https://resend.com
RESEND_API_KEY=

# Google Safe Browsing API Key (optional, for web browsing safety)
# Get yours at https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=

# Web browsing safety mode: "allowlist" or "safebrowsing"
WEB_BROWSE_SAFETY_MODE=safebrowsing

# App URL (used for email verification links)
# APP_URL=https://your-app.railway.app

# Email configuration
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# EMAIL_FROM_NAME=LocalBBS
